(* Content-type: application/vnd.wolfram.mathematica *)
Notebook[{
Cell["SO(5) mixed scalar bootstrap CFT data", "Title"],
Cell["Derivative order 23 | Skydiving ver4 | EFM v3", "Subtitle"],
Cell["External dimensions and OPE ratios", "Section"],
Cell[BoxData[GridBox[{{"Operator", "Dimension"}, {"phi", "0.613734575252"}, {"s", "2.25838827072"}, {"t", "1.46401737277"}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {False, True, {False}}}]], "Output"],
Cell[BoxData[GridBox[{{"OPE numerator", "Ratio to lambda(phi,phi,t)"}, {"phi_phi_s", "0.294245844525"}, {"t_t_t", "1.26168944318"}, {"s_t_t", "0.686957170616"}, {"s_s_s", "0.267598288143"}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {False, True, {False}}}]], "Output"],
Cell["Spectrum and signed OPE vectors", "Section"],
Cell["The spectrum has 971 channel roots and 985 OPE-vector records, plus a separate fixed external normalization. Group by channel_index and root_index. Each component_index identifies one vector in the same-root decomposition. The zero-based matrix_index selects the matching record within the raw matrix block. Imposed gaps and provisional amplitudes have separate flags.", "Text"],
Cell["Evaluate the loading cell first. All reported decimal digits are stored as text so they survive reading and export. The external-pair order is explicit in each spectrum record.", "Text"],
Cell[BoxData[RowBox[{"cftData", "=", RowBox[{"ImportString", "[", RowBox[{RowBox[{"CurrentValue", "[", RowBox[{RowBox[{"EvaluationNotebook", "[", "]"}], ",", RowBox[{"{", RowBox[{"TaggingRules", ",", "\"CFTDataJSON\""}], "}"}]}], "]"}], ",", "\"RawJSON\""}], "]"}], ";"}]], "Input"],
Cell[BoxData[RowBox[{"Dataset", "[", RowBox[{"cftData", "[", "\"spectrum\"", "]"}], "]"}]], "Input"],
Cell["Singlet spin-two root at dimension 3", "Section"],
Cell["The matrix uses the same normalization as the spectrum. Its diagonal square roots give the total amplitudes at this root. The Ward upper bound applies to a single stress coupling at the fixed matrix.", "Text"],
Cell[BoxData[RowBox[{"Dataset", "[", RowBox[{"cftData", "[", "\"stress_root\"", "]"}], "]"}]], "Input"],
Cell["Channel index including empty channels", "Section"],
Cell[BoxData[RowBox[{"Dataset", "[", RowBox[{"cftData", "[", "\"channels\"", "]"}], "]"}]], "Input"]
},
